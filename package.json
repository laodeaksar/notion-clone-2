{
  "name": "notion-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"server,client\" -c \"cyan,magenta\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --watch server/index.ts",
    "dev:client": "cd client && bun run dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "build:client": "cd client && bun run build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@liveblocks/client": "^2.22.0",
    "@liveblocks/node": "^2.22.0",
    "@liveblocks/yjs": "^2.22.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.44.0",
    "effect": "^3.14.0",
    "elysia": "^1.4.28",
    "postgres": "^3.4.5",
    "valibot": "^1.1.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.3"
  }
}
