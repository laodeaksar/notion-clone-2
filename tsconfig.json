{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "baseUrl": ".",
    "skipLibCheck": true
  },
  "include": ["server/**/*", "shared/**/*", "drizzle.config.ts"]
}
