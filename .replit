modules = ["bun-1.3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "3000"
NODE_ENV = "development"
BETTER_AUTH_URL = "http://localhost:3000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Client (Svelte)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server (Elysia)"

[[workflows.workflow]]
name = "Client (Svelte)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && bun run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Server (Elysia)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run dev:server"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80
